# Environment Configuration Template
# Copy this file to .env for local development
# Add these to GitHub Secrets for CI/CD

# ============================================
# Google Analytics
# ============================================
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# Sentry (Optional - for error monitoring)
# ============================================
# Frontend Sentry DSN
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXX.ingest.de.sentry.io/XXXXXXX

# Backend Sentry DSN (if using backend)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXX.ingest.de.sentry.io/XXXXXXX

# ============================================
# App Version (for Sentry releases)
# ============================================
VITE_APP_VERSION=1.0.0

# ============================================
# Database (Optional - only if using backend)
# ============================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/portfolio

# ============================================
# GitHub Pages Deployment
# ============================================
# Manual deployment reads the VITE_* values above at build time.
# Run `npm run deploy` after configuring a local .env file.

# ============================================
# Development Server Port
# ============================================
PORT=5000

# ============================================
# Node Environment
# ============================================
NODE_ENV=development
# For production: NODE_ENV=production

# ============================================
# GitHub Actions Secrets (for CI/CD)
# ============================================
# Add these to GitHub repository secrets:
# - SENTRY_DSN (optional)
# - GOOGLE_ANALYTICS_ID (optional)
# - DATABASE_URL (optional - only if using backend)

# ============================================
# Security (Optional)
# ============================================
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100  # requests per window
